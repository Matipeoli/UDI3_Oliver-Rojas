# Copiá este archivo como .env y completá la clave. El .env NO se sube a ningún repositorio.

# Clave de Google AI Studio (https://aistudio.google.com/apikey)
GEMINI_API_KEY=pegá_tu_clave_acá
GEN_MODEL=gemini-2.5-flash

# Embeddings locales con Ollama (ollama pull bge-m3)
OLLAMA_URL=http://localhost:11434
EMB_MODEL=bge-m3
# Tiene que coincidir con VECTOR(n) de la tabla. bge-m3 devuelve 1024 números.
DIMENSIONES=1024

# Base de datos (docker compose up -d)
DATABASE_URL=postgresql://rag:rag@localhost:5433/rag

# Búsqueda
K=3
# Similitud mínima. Valor provisorio: calibralo con `npm run calibrar`.
UMBRAL=0.5

PORT=3000
